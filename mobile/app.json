{
  "expo": {
    "name": "Rekalla",
    "slug": "rekalla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rekalla",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12181C",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12181C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jacksonsanders.rekalla",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jacksonsanders.rekalla",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#12181C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rekalla uses your photos so you can add a picture of someone you want to practise remembering.",
          "cameraPermission": "Rekalla uses your camera so you can take a picture of someone you want to practise remembering."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7DD53F"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "59c872ad-d2b9-4413-a884-1a67b75e1d13"
      }
    }
  }
}
